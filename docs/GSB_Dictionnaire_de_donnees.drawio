nter;" vertex="1" parent="1"><mxGeometry x="1004" y="1839" width="86" height="31" as="geometry"/></mxCell><mxCell id="mc20" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;startArrow=none;endArrow=classic;endFill=1;endSize=9;strokeColor=#A3B6C5;strokeWidth=2.5;jumpStyle=none;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="HISTORIQUE_STATUT" target="historiser"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mc20_card" value="1 : 1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#E4E8EC;fontSize=25;strokeColor=none;fillColor=none;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="584" y="2197" width="86" height="31" as="geometry"/></mxCell><mxCell id="mc21" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;startArrow=none;endArrow=classic;endFill=1;endSize=9;strokeColor=#668E49;strokeWidth=2.5;jumpStyle=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="COMMANDE" target="regler"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mc21_card" value="0 : 1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#E4E8EC;fontSize=25;strokeColor=none;fillColor=none;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1124" y="1839" width="86" height="31" as="geometry"/></mxCell><mxCell id="mc22" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;startArrow=none;endArrow=classic;endFill=1;endSize=9;strokeColor=#668E49;strokeWidth=2.5;jumpStyle=none;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="PAIEMENT_SIMULE" target="regler"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mc22_card" value="1 : 1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#E4E8EC;fontSize=25;strokeColor=none;fillColor=none;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1124" y="2197" width="86" height="31" as="geometry"/></mxCell><mxCell id="mc23" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;startArrow=none;endArrow=classic;endFill=1;endSize=9;strokeColor=#FF9186;strokeWidth=2.5;jumpStyle=none;exitX=0.8529411764705882;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="COMMANDE" target="livrer"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="1940"/><mxPoint x="1770" y="1940"/></Array></mxGeometry></mxCell><mxCell id="mc23_card" value="0 : 1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#E4E8EC;fontSize=25;strokeColor=none;fillColor=none;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1244" y="1839" width="86" height="31" as="geometry"/></mxCell><mxCell id="mc24" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;startArrow=none;endArrow=classic;endFill=1;endSize=9;strokeColor=#FF9186;strokeWidth=2.5;jumpStyle=none;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="LIVRAISON_FICTIVE" target="livrer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mc24_card" value="1 : 1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#E4E8EC;fontSize=25;strokeColor=none;fillColor=none;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1784" y="2197" width="86" height="31" as="geometry"/></mxCell><mxCell id="legend_bg" value="" style="fillColor=#161616;strokeColor=#535353;rounded=0;" vertex="1" parent="1"><mxGeometry x="70" y="2510" width="2960" height="245" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;LÉGENDE&lt;/b&gt;&lt;br&gt;Identifiant souligné · Cardinalité placée près de l’entité : 0 : 1 / 1 : 1 / 0 : N / 1 : N.&lt;br&gt;Les cardinalités expriment les règles métier ; les pointes de flèche sont une convention graphique.&lt;br&gt;Les couleurs servent uniquement de repères visuels. CONTENIR et COMPORTER portent des attributs.&lt;br&gt;Chaque produit est fourni par un seul laboratoire. Les commandes en préparation restent dans PANIER." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#E4E8EC;fontSize=19;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="95" y="2525" width="1450" height="215" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;RÈGLES MÉTIER RETENUES&lt;/b&gt;&lt;br&gt;Une commande contient au moins une ligne et un statut initial ; quantité strictement positive.&lt;br&gt;Nom du produit, prix HT, TVA et prix TTC de ligne sont figés à l’achat.&lt;br&gt;Chaque fournisseur dispose d’au moins un compte ; création du laboratoire et du premier compte dans la même opération.&lt;br&gt;Un compte Fournisseur est rattaché à un seul laboratoire ; les autres rôles ne le sont pas.&lt;br&gt;Un fournisseur ne gère que ses propres produits. Profil santé réservé au rôle Professionnel." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#E4E8EC;fontSize=19;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1580" y="2525" width="1420" height="215" as="geometry"/></mxCell><mxCell id="scope_bg" value="" style="fillColor=#161616;strokeColor=#535353;rounded=0;" vertex="1" parent="1"><mxGeometry x="70" y="2790" width="2960" height="140" as="geometry"/></mxCell><mxCell id="scope" value="&lt;b&gt;EXTENSIONS PRÉVUES — SIMULATION UNIQUEMENT&lt;/b&gt;&lt;br&gt;PAIEMENT_SIMULE : succès ou échec, sans transaction réelle. LIVRAISON_FICTIVE : suivi et dates simulés.&lt;br&gt;MOUVEMENT_STOCK : variations de stock fictif tracées. Ces trois fonctionnalités sont des extensions volontaires du projet.&lt;br&gt;Au maximum un résultat de paiement et une livraison par commande ; panier persistant unique par professionnel, créé à la demande." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#E4E8EC;fontSize=19;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="95" y="2805" width="2910" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="mld-prof" name="03 — MLD"><mxGraphModel grid="0" page="1" pageScale="1" pageWidth="3400" pageHeight="3250" background="#111111"><root><mxCell id="0"/><mxCell id="background_layer" value="Fond quadrillé" style="locked=1;" parent="0"/><mxCell id="background" value="" style="fillColor=#111111;strokeColor=none;locked=1;" vertex="1" parent="background_layer"><mxGeometry width="3400" height="3250" as="geometry"/></mxCell><mxCell id="grid_x0" value="" style="fillColor=#262626;strokeColor=none;locked=1;" vertex="1" parent="background_layer"><mxGeometry x="0" width="1" height="3250" as="geometry"/></mxCell><mxCell id="grid_x20" value="" style="fillColor=#1B1B1B;strokeColor=none;locked=1;" vertex="1" parent="background_layer"><mxGeometry x="20" width="1" height="3250" as="geometry"/></mxCell><mxCell id="grid_x40" value="" style="fillColor=#1B1B1B;strokeColor=none;locked=1;" vertex="1" parent="background_layer"><mxGeometry x="40" width="1" height="3250" as="geometry"/></mxCell><mxCell id="grid_x60" value="" style="fillColor=#1B1B1B;strokeColor=none;locked=1;" vertex="1" parent="background_layer"><mxGeometry x="60" width="1" height="3250" as="geometry"/></mxCell><mxCell id="grid_x80" value="" style="fillColor=#1B1B1B;strokeColor=none;locked=1;" vertex="1" parent="background_layer"><mxGeometry x="80" width="1" height="3250" as="geometry"/></mxCell><mxCell id="grid_x100" value="" style="fillColor=#262626;strokeColor=none;locked=1;" vertex="1" parent="background_layer"><mxGeometry x="100" width="1" height="3250" as="geometry"/></mxCell><mxCell id="grid_x120" value="" style="fillColor=#1B1B1B;strokeColor=none;locked=1;" vertex="1" parent="background_layer"><mxGeometry x="120" width="1" height="3250" as="geometry"/></mxCell><mxCell id="grid_x140" value="" style="fillColor=#1B