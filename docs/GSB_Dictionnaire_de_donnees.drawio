ze=9;strokeColor=#3D6128;strokeWidth=2.5;jumpStyle=none;exitX=0;exitY=0.38461538461538464;entryX=1;entryY=0.8857142857142857;" edge="1" parent="1" source="MOUVEMENT_STOCK" target="PRODUIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fk09" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;startArrow=none;endArrow=classic;endFill=1;endSize=9;strokeColor=#F27816;strokeWidth=2.5;jumpStyle=none;exitX=0;exitY=0.3741496598639456;entryX=0.5;entryY=1;" edge="1" parent="1" source="COMMANDE" target="PROFESSIONNEL_SANTE"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="1820"/></Array></mxGeometry></mxCell><mxCell id="fk10" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;startArrow=none;endArrow=classic;endFill=1;endSize=9;strokeColor=#92504C;strokeWidth=2.5;jumpStyle=none;exitX=0;exitY=0.46218487394957986;entryX=1;entryY=0.3741496598639456;" edge="1" parent="1" source="LIGNE_COMMANDE" target="COMMANDE"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fk11" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;startArrow=none;endArrow=classic;endFill=1;endSize=9;strokeColor=#92504C;strokeWidth=2.5;jumpStyle=none;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="LIGNE_COMMANDE" target="PRODUIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fk12" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;startArrow=none;endArrow=classic;endFill=1;endSize=9;strokeColor=#8798A8;strokeWidth=2.5;jumpStyle=none;exitX=0.5;exitY=0;entryX=0.23684210526315788;entryY=1;" edge="1" parent="1" source="HISTORIQUE_STATUT" target="COMMANDE"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="2190"/><mxPoint x="990" y="2190"/></Array></mxGeometry></mxCell><mxCell id="fk13" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;startArrow=none;endArrow=classic;endFill=1;endSize=9;strokeColor=#3D6128;strokeWidth=2.5;jumpStyle=none;exitX=0.5;exitY=0;entryX=0.5526315789473685;entryY=1;" edge="1" parent="1" source="PAIEMENT_SIMULE" target="COMMANDE"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1390" y="2290"/><mxPoint x="1110" y="2290"/></Array></mxGeometry></mxCell><mxCell id="fk14" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;html=1;startArrow=none;endArrow=classic;endFill=1;endSize=9;strokeColor=#FF9186;strokeWidth=2.5;jumpStyle=none;exitX=0.5;exitY=0;entryX=0.868421052631579;entryY=1;" edge="1" parent="1" source="LIVRAISON_FICTIVE" target="COMMANDE"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2190" y="2150"/><mxPoint x="1230" y="2150"/></Array></mxGeometry></mxCell><mxCell id="legend_bg" value="" style="fillColor=#161616;strokeColor=#535353;rounded=0;" vertex="1" parent="1"><mxGeometry x="70" y="2760" width="3260" height="155" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;CONVENTIONS DU MLD&lt;/b&gt;&lt;br&gt;Attribut souligné : clé primaire · # : clé étrangère · [UQ] : unicité · (facultatif) : lien optionnel du dictionnaire.&lt;br&gt;Flèche : relation contenant la clé étrangère → relation référencée. Aucun type SQL ni AUTO_INCREMENT à ce niveau." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#E4E8EC;fontSize=20;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="95" y="2775" width="1690" height="120" as="geometry"/></mxCell><mxCell id="composites" value="&lt;b&gt;PASSAGE DU MCD AU MLD&lt;/b&gt;&lt;br&gt;CONTENIR → PANIER_PRODUIT ; clé composée : (#id_panier, #id_produit).&lt;br&gt;COMPORTER → LIGNE_COMMANDE ; clé composée : (#id_commande, #id_produit).&lt;br&gt;Les deux attributs soulignés forment ensemble la clé primaire de chaque relation associative." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#E4E8EC;fontSize=20;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1810" y="2775" width="1490" height="120" as="geometry"/></mxCell><mxCell id="rules_bg" value="" style="fillColor=#161616;strokeColor=#535353;rounded=0;" vertex="1" parent="1"><mxGeometry x="70" y="2960" width="3260" height="215" as="geometry"/></mxCell><mxCell id="business_rules" value="&lt;b&gt;CONTRAINTES À RESPECTER DANS L’APPLICATION&lt;/b&gt;&lt;br&gt;PRODUIT.#id_fournisseur est obligatoire. UTILISATEUR.#id_fournisseur est obligatoire pour le rôle Fournisseur, NULL pour les autres.&lt;br&gt;Chaque laboratoire possède au moins un compte Fournisseur ; créer les deux dans la même transaction. Aucune unicité sur ce rattachement.&lt;br&gt;Au moins une ligne par commande ; quantités positives. Les prix, la TVA et le nom de ligne restent ceux de l’achat.&lt;br&gt;Contrôler les droits par laboratoire : un compte Fournisseur ne gère que les produits du fournisseur auquel il appartient.&lt;br&gt;Extensions prévues : paiement simulé, livraison fictive et mouvements de stock fictif. Ces fonctionnalités restent à développer." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#E4E8EC;fontSize=19;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="95" y="2975" width="3210" height="185" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
